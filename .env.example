# ============================================================================
# Variables PÚBLICAS (prefijo VITE_): se incluyen en el bundle del navegador.
# Nunca coloques secretos, tokens ni claves privadas aquí.
# ============================================================================

# Opcional. Endpoint del formulario si el receptor no está en /api/contact del mismo sitio.
# Acepta una ruta del mismo origen (p. ej. /api/contact) o una URL HTTPS con CORS configurado.
VITE_CONTACT_ENDPOINT=

# Opcional. Correo corporativo verificado que se muestra en el pie de página.
VITE_CONTACT_EMAIL=

# Opcionales. Solo se mostrarán URLs HTTPS verificadas de perfiles corporativos.
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_YOUTUBE=

# Opcionales. Enlaces legales publicados y aprobados (ruta local o URL HTTPS).
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# ============================================================================
# Variables de SERVIDOR (solo en el panel del proveedor de hosting, NUNCA en Git).
# Usadas por functions/api/contact.ts. No copiar valores reales en este archivo.
#
#   CONTACT_WEBHOOK_URL       URL HTTPS del sistema que recibe las solicitudes (obligatoria para aceptar envíos).
#   CONTACT_WEBHOOK_TOKEN     Token Bearer del webhook (opcional, recomendado).
#   CONTACT_ALLOWED_ORIGINS   Orígenes adicionales permitidos, separados por comas (opcional).
# ============================================================================
