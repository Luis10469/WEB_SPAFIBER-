# Recomendado: endpoint HTTPS que valide, limite peticiones y procese solicitudes en el servidor.
# Esta variable se expone al navegador; no coloques secretos ni claves privadas aquí.
# Acepta una ruta del mismo origen (por ejemplo, /api/contact) o una URL HTTPS.
VITE_CONTACT_ENDPOINT=

# Alternativa opcional al endpoint. Se abrirá el cliente de correo y el usuario deberá enviar el mensaje.
# Configura solo una dirección oficial verificada de SPEFIBER.
VITE_CONTACT_EMAIL=

# Opcionales. Solo se mostrarán URLs HTTPS verificadas.
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_YOUTUBE=

# Opcionales. Enlaces legales publicados y aprobados.
VITE_PRIVACY_URL=
VITE_TERMS_URL=
